from google import genai
#Integrate and fetch from gemini API
client = genai.Client(api_key="YOUR_API_KEY")
#Use prompt eng
def generate_notes(text):
    prompt = f"""
    Convert this content into structured
    NEET revision notes.

    Include:
    1. Important concepts
    2. Key definitions
    3. Important points

    Content:
    {text}
    """
    #From models.generate_content choose the model and provide the prompt as content
    response = client.models.generate_content(
        model="YOUR_AVAILABLE_GEMINI_MODEL",
        contents=prompt
    )

    return response.text
